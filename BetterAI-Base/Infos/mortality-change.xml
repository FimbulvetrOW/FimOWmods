		<iInitLeaderSafeTurns/>
		<!-- For the AI, to calculate remaining life expectancy of healthy characters. The first 7 fields are for Generals because they have a retirement age, the other 7 fields are for others -->
		<!-- Max Age (average dying age for healthy Character at a certain age) is determined with a polynomial function: a + bx + cx² (x = Character age) -->
		<!-- The first 3 fields determine how the max age for Generals older than iMaxAgeGenOld is calculated -->
		<iMaxAgeGenOldaX10/>     <!-- These fields only take integer. Fill out with 10 * a -->
		<iMaxAgeGenOldbX1000/>   <!-- 1000 * b -->
		<iMaxAgeGenOldcX100000/> <!-- 100000 * c  -->
		<iMaxAgeGenOld/>         <!-- Characters younger than this will use the factors below -->
		<iMaxAgeGenYoungaX10/>
		<iMaxAgeGenYoungbX1000/>
		<iMaxAgeGenYoungcX100000/>
		<iMaxAgeGenYoungMinAge/><!-- Characters younger than this will assume same max age as Characters that are exactly this old -->
		<!-- The following fields are used for Characters/jobs without retirement age -->
		<iMaxAgeOldaX10/>
		<iMaxAgeOldbX1000/>
		<iMaxAgeOldcX100000/>
		<iMaxAgeOld/>            <!-- Characters younger than this will use the factors below -->
		<iMaxAgeYoungaX10/>
		<iMaxAgeYoungbX1000/>
		<iMaxAgeYoungcX100000/>
		<iMaxAgeYoungMinAge/><!-- Characters younger than this will assume same max age as Characters that are exactly this old -->
	</Entry>
